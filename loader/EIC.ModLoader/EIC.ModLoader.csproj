  <Target Name="DeployPluginArtifacts" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="..\..\game\BepInEx\plugins\EIC.ModLoader.dll" />
    <Copy SourceFiles="$(OutputPath)Crabtya.ModApi.dll" DestinationFiles="..\..\game\BepInEx\plugins\Crabtya.ModApi.dll" Condition="Exists('$(OutputPath)Crabtya.ModApi.dll')" />
