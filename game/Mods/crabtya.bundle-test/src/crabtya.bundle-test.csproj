<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>crabtya.bundle-test</AssemblyName>
    <RootNamespace>Crabtya.BundleTest</RootNamespace>
    <!-- Output directly to the mod's bin/ folder so the manifest path resolves. -->
    <OutputPath>..\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Crabtya public mod API - provides ICrabtyaMod, ICrabtyaModContext, etc. -->
    <Reference Include="Crabtya.ModApi">
      <HintPath>..\..\..\BepInEx\plugins\Crabtya.ModApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- EIC.ModLoader - provides AssetBundleApplicator.GetBundle(). -->
    <Reference Include="EIC.ModLoader">
      <HintPath>..\..\..\BepInEx\plugins\EIC.ModLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Unity interop assemblies - required for AssetBundle and Texture2D types. -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\..\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>..\..\..\BepInEx\interop\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- IL2CPP interop runtime support. -->
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>..\..\..\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>..\..\..\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
