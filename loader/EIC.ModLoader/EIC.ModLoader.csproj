<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>EIC.ModLoader</AssemblyName>
    <RootNamespace>EIC.ModLoader</RootNamespace>
    <PackageId>Crabtya.ModLoader</PackageId>
    <Product>Crabtya.ModLoader</Product>
    <AssemblyTitle>Crabtya.ModLoader</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crabtya.ModApi\Crabtya.ModApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>..\..\game\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
