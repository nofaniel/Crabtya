# ─── Game install (local only — not for source control) ───────────────────────
# The game is installed under game/ for local development.
# None of the game binaries, game data, or engine DLLs belong in source control.

game/Everything is Crab.exe
game/Everything is Crab_Data/
game/GameAssembly.dll
game/UnityPlayer.dll
game/UnityCrashHandler64.exe
game/baselib.dll
game/EOSBootstrapper.exe
game/EOSBootstrapper.ini
game/20000
game/D3D12/

# ─── BepInEx runtime (installed by package, not source) ───────────────────────
game/BepInEx/cache/
game/BepInEx/core/
game/BepInEx/interop/
game/BepInEx/patchers/
game/BepInEx/unity-libs/
game/BepInEx/plugins/
game/BepInEx/LogOutput.log
game/BepInEx/ErrorLog.log
game/dotnet/

# ─── Doorstop / launcher (installed by package, not source) ───────────────────
game/winhttp.dll
game/doorstop_config.ini
game/.doorstop_version
game/changelog.txt
game/__LAUNCHER.bat

# ─── Runtime state (written at runtime, not source) ───────────────────────────
game/Mods/mod-state.json
game/Mods/startup-commands.json
game/Mods/runtime-settings.json
game/Mods/validation-backup-*/
game/CrabtyaData/

