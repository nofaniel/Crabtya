<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>crabtya.bundle-test</AssemblyName>
    <RootNamespace>Crabtya.BundleTest</RootNamespace>
    <!-- Output directly to the mod's bin/ folder so the manifest path resolves. -->
    <OutputPath>..\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Crabtya public mod API - provides ICrabtyaMod, ICrabtyaModContext, etc. -->
    <Reference Include="Crabtya.ModApi">
      <HintPath>..\..\..\BepInEx\plugins\Crabtya.ModApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Unity interop assembly used by this sample's Texture2D checks. -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\..\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
